        "tool_235d3c": {
          "spec": {
            "kind": "tool",
            "name": "tool_235d3c",
            "tool": "populate_word_template",
            "position": {
              "x": 58.291268961687365,
              "y": 1374.9370005878618
            },
            "description": "Populate a Word document template with data from a JSON string.\n\nThis tool takes a JSON string containing key-value pairs and a Word document\ntemplate (as bytes), then replaces template placeholders with the provided data.\nThe template should use Jinja2 syntax for placeholders (e.g., {{ variable_name }}).",
            "display_name": "populate_word_template",
            "input_schema": {
              "type": "object",
              "required": [
                "json_data",
                "template_bytes"
              ],
              "properties": {
                "json_data": {
                  "type": "string",
                  "title": "Json Data",
                  "description": "A JSON string containing the data to populate the template.\nExample: '{\"name\": \"John Doe\", \"position\": \"Software Engineer\"}'"
                },
                "template_bytes": {
                  "type": "string",
                  "title": "Template Bytes",
                  "format": "binary",
                  "description": "The Word document template as bytes. The template should\ncontain Jinja2-style placeholders like {{ name }}, {{ position }}, etc."
                }
              }
            },
            "output_schema": {
              "type": "string",
              "format": "binary",
              "description": "The populated Word document as bytes."
            },
            "error_handler_config": {
              "max_retries": 0,
              "error_message": "Something went wrong while running 'populate_word_template'",
              "retry_interval": 1000
            }
          },
          "input_map": {
            "spec": {
              "maps": [
                {
                  "metadata": {
                    "assignmentType": "variable"
                  },
                  "has_no_value": false,
                  "target_variable": "self.input.template_bytes",
                  "value_expression": "flow[\"CV Converter\"].Template.output.value"
                },
                {
                  "metadata": {
                    "assignmentType": "variable"
                  },
                  "has_no_value": false,
                  "target_variable": "self.input.json_data",
                  "value_expression": "flow[\"CV Converter\"][\"JSON Modifier\"].output.value"
                }
              ],
              "name": "",
              "fallback_strategy": "ask_the_user"
            }
          }
        },
